Server::Server(const config &cfg)
: _server_fd(-1), _config(cfg)
{
}

Server::~Server()
{
    if (_server_fd != -1)
        close(_server_fd);
}

bool Server::initSocket()
{
    struct addrinfo hints;
    struct addrinfo *result;
    struct addrinfo *current;
    int status;
    int opt = 1;

    std::memset(&hints, 0, sizeof(hints));
    hints.ai_family = AF_INET;
    hints.ai_socktype = SOCK_STREAM;
    hints.ai_flags = AI_PASSIVE;

    status = getaddrinfo(NULL, std::to_string(_config.port).c_str(), &hints, &result);
    if (status != 0)
    {
        std::cerr << "getaddrinfo: " << gai_strerror(status) << std::endl;
        return false;
    }

    for (current = result; current != NULL; current = current->ai_next)
    {
        _server_fd = socket(current->ai_family, current->ai_socktype, current->ai_protocol);
        if (_server_fd == -1)
            continue;

        if (setsockopt(_server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt)) == -1)
        {
            close(_server_fd);
            _server_fd = -1;
            continue;
        }

        if (bind(_server_fd, current->ai_addr, current->ai_addrlen) == 0)
            break;

        close(_server_fd);
        _server_fd = -1;
    }

    freeaddrinfo(result);

    if (current == NULL)
    {
        std::cerr << "bind: unable to create server socket" << std::endl;
        return false;
    }

    if (listen(_server_fd, SOMAXCONN) == -1)
    {
        std::perror("listen");
        close(_server_fd);
        _server_fd = -1;
        return false;
    }

    std::cout << "Server listening on port " << _config.port << std::endl;
    return true;
}

